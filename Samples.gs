/** 초기화 후 실행하면 현재 활성 팀 중 앞의 두 팀에 샘플을 추가합니다. 중복 실행을 차단합니다. */
function seedDemoData_() {
  return locked_(function() {
    if (!props_().getProperty('ADMIN_HASH')) fail_('SETUP', 'initialize_를 먼저 실행해 주세요.');
    if (props_().getProperty('DEMO_CARD_IDS')) fail_('SETUP', '이미 샘플이 있습니다. removeDemoData_로 제거한 뒤 다시 추가하세요.');
    var teams = rows_('Teams').filter(active_).sort(function(a,b) { return Number(a.sortOrder)-Number(b.sortOrder); });
    if (teams.length < 2) fail_('SETUP', '샘플에는 활성 팀이 두 개 필요합니다.');
    var ids = [], now = new Date().toISOString();
    sampleCards_().forEach(function(c, i) {
      c.cardId = Utilities.getUuid(); c.teamId = teams[i < 2 ? 0 : 1].teamId;
      c.tagsJson = JSON.stringify(c.tags); c.quizOptionsJson = JSON.stringify(c.quizOptions);
      c.createdAt = now; c.updatedAt = now; c.publishedAt = now;
      // 매번 등록 ID를 먼저 남겨 중간 실패 후에도 제거할 수 있게 합니다.
      ids.push(c.cardId); props_().setProperty('DEMO_CARD_IDS', JSON.stringify(ids)); writeRow_('Cards', c);
    });
    console.log('가상 상황 샘플 4개를 추가했습니다. 실제 수업 전에 제거해 주세요.');
  });
}
/** 샘플로 기록된 카드만 삭제합니다. 학생이 만든 카드는 보존합니다. */
function removeDemoData_() {
  return locked_(function() {
    var ids = JSON.parse(props_().getProperty('DEMO_CARD_IDS') || '[]');
    rows_('Cards').filter(function(c) { return ids.indexOf(c.cardId) >= 0; }).sort(function(a,b) { return b._row-a._row; }).forEach(function(c) { sheet_('Cards').deleteRow(c._row); });
    props_().deleteProperty('DEMO_CARD_IDS'); console.log('기록된 샘플 카드만 제거했습니다.');
  });
}
